  "compiledShaders": [
    {
      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nattribute vec3 a_position;\nattribute vec2 a_uv0;\nattribute vec4 a_color;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nvoid main () {\n  gl_Position = cc_matViewProj * vec4(a_position, 1.0);\n  v_uv0 = a_uv0;\n  v_color = a_color;\n}",
        "frag": "\nprecision highp float;\nuniform vec4 cc_time;\nuniform sampler2D texture;\nuniform vec4 vignetteParams;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nvec4 sampleTex(vec2 uv) {\n  vec4 c = vec4(1.0);\n  vec4 texture_tmp = texture2D(texture, uv);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, uv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    c.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    c.a *= texture_tmp.a;\n  #else\n    c *= texture_tmp;\n  #endif\n  return c;\n}\nvoid main () {\n  vec2 uv = v_uv0;\n  sampleTex(uv);\n  float intensity = vignetteParams.x;\n  float speed = vignetteParams.y;\n  float inner = vignetteParams.z;\n  float outer = vignetteParams.w;\n  vec2 p = (uv - vec2(0.5)) * 2.0;\n  float edge = length(p);\n  float vignette = smoothstep(inner, outer, edge);\n  float pulse = 0.68 + 0.32 * sin(cc_time.x * speed);\n  float alpha = vignette * intensity * pulse;\n  alpha = clamp(alpha, 0.0, 0.22);\n  vec3 redColor = vec3(1.0, 0.02, 0.02);\n  gl_FragColor = vec4(redColor, alpha) * v_color;\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nin vec3 a_position;\nin vec2 a_uv0;\nin vec4 a_color;\nout vec2 v_uv0;\nout vec4 v_color;\nvoid main () {\n  gl_Position = cc_matViewProj * vec4(a_position, 1.0);\n  v_uv0 = a_uv0;\n  v_color = a_color;\n}",
        "frag": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform sampler2D texture;\nuniform ARGS {\n  vec4 vignetteParams;\n};\nin vec2 v_uv0;\nin vec4 v_color;\nvec4 sampleTex(vec2 uv) {\n  vec4 c = vec4(1.0);\n  vec4 texture_tmp = texture(texture, uv);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture(texture, uv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    c.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    c.a *= texture_tmp.a;\n  #else\n    c *= texture_tmp;\n  #endif\n  return c;\n}\nvoid main () {\n  vec2 uv = v_uv0;\n  sampleTex(uv);\n  float intensity = vignetteParams.x;\n  float speed = vignetteParams.y;\n  float inner = vignetteParams.z;\n  float outer = vignetteParams.w;\n  vec2 p = (uv - vec2(0.5)) * 2.0;\n  float edge = length(p);\n  float vignette = smoothstep(inner, outer, edge);\n  float pulse = 0.68 + 0.32 * sin(cc_time.x * speed);\n  float alpha = vignette * intensity * pulse;\n  alpha = clamp(alpha, 0.0, 0.22);\n  vec3 redColor = vec3(1.0, 0.02, 0.02);\n  gl_FragColor = vec4(redColor, alpha) * v_color;\n}"
